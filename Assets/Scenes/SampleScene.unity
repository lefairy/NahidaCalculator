    - target: {fileID: 7521225473031521286, guid: f6757ed149545154b9d380ed2a86536d, type: 3}
      propertyPath: m_text
      value: "\u6570\u503C\u8BA1\u7B97\u6A21\u5F0F\uFF1A\u652F\u6301\u539F\u795E\u548C\u661F\u7A79\u94C1\u9053\u4E24\u6B3E\u6E38\u620F\u7684\u8BA1\u7B97\uFF0C\u5177\u4F53\u5DEE\u5F02\u5305\u62EC\uFF1A\n
        \u2022 \u5C5E\u6027\u4E0B\u62C9\u6846\u548C\u9762\u677F\u4E2D\u9690\u85CF\u5BF9\u5E94\u5C5E\u6027\u548C\u500D\u7387\uFF0C\u5982\u539F\u795E\u6A21\u5F0F\u9690\u85CF\u901F\u5EA6\u3001\u51FB\u7834\u3001\u6B22\u6109\u7B49\u76F8\u5173\u5C5E\u6027\uFF0C\u661F\u94C1\u6A21\u5F0F\u9690\u85CF\u5143\u7D20\u53CD\u5E94\u76F8\u5173\u5C5E\u6027\u7B49\n
        \u2022 \u5DF2\u5B58\u5728\u7684\u88AB\u9690\u85CF\u7684\u5C5E\u6027\u4ECD\u53EF\u4EE5\u586B\u5199\uFF0C\u4F46\u5728\u4F24\u5BB3\u8BA1\u7B97\u4E2D\u89C6\u4E3A0\uFF0C\u661F\u94C1\u6A21\u5F0F\u4E0D\u8BA1\u7B97\u5143\u7D20\u53CD\u5E94\n
        \u2022 \u5177\u6709\u4E0D\u540C\u7684\u8BCD\u6761\u9ED8\u8BA4\u503C\uFF0C\u9700\u8981\u4F7F\u7528\u201C\u6839\u636E\u6A21\u5F0F\u91CD\u7F6E\u8BCD\u6761\u9ED8\u8BA4\u503C\u201D\u6309\u94AE\u6765\u91CD\u7F6E\uFF0C\u4EC5\u5207\u6362\u6A21\u5F0F\u4E0D\u4F1A\u4FEE\u6539\u8BCD\u6761\u9ED8\u8BA4\u503C\n
        \u2022 \u5177\u6709\u4E0D\u540C\u7684\u9ED8\u8BA4\u7B49\u7EA7\uFF0C\u7559\u7A7A\u65F6\u4F7F\u7528\u9ED8\u8BA4\u7B49\u7EA7\uFF0C\u5DF2\u586B\u5165\u5177\u4F53\u503C\u65F6\u4E0D\u4F1A\u56E0\u4E3A\u5207\u6362\u6A21\u5F0F\u800C\u6539\u53D8\n
        \u2022 \u9632\u5FA1\u548C\u6297\u6027\u8BA1\u7B97\u516C\u5F0F\u4E0D\u540C\uFF0C\u5177\u4F53\u516C\u5F0F\u89C1\u8BA1\u7B97\u8BF4\u660E"
      objectReference: {fileID: 0}
