    - target: {fileID: 7521225473031521286, guid: f6757ed149545154b9d380ed2a86536d, type: 3}
      propertyPath: m_text
      value: "\u5267\u53D8\u53CD\u5E94=(\u7CBE\u901A\u4E58\u533A*\u7C7B\u578B\u7CFB\u6570*\u7B49\u7EA7\u7CFB\u6570*(1+\u53CD\u5E94\u57FA\u7840\u4F24\u5BB3\u63D0\u5347)+\u53CD\u5E94\u4F24\u5BB3\u503C\u63D0\u5347)*\u5267\u53D8\u89E6\u53D1\u6B21\u6570*\u989D\u5916\u4E58\u533A\n
        \u2022 \u7CBE\u901A\u4E58\u533A=1+\u7CFB\u6570A*\u7CBE\u901A/(\u7CBE\u901A+\u7CFB\u6570B)+\u5267\u53D8\u52A0\u6210\n
        \u2022 \u7CFB\u6570A\u3001B\uFF1A\u6FC0\u53165\u30011200\uFF0C\u5267\u53D816\u30012000\uFF0C\u6708\u5267\u53D86\u30012000\n
        \u2022 \u7C7B\u578B\u7CFB\u6570\uFF1A\u8D85\u6FC0\u53161.15\uFF0C\u8513\u6FC0\u53161.25\uFF0C\u6269\u65630.6\uFF0C\u611F\u75352\uFF0C\u8D85\u5BFC1.5\uFF0C\u8D85\u8F7D2.75\uFF0C\u788E\u51B03\uFF0C\u7EFD\u653E2\uFF0C\u8D85\u7EFD\u653E3\uFF0C\u70C8\u7EFD\u653E3\uFF0C\u6708\u611F\u75353\uFF0C\u6708\u7ED3\u66761.6\uFF0C\u661F\u6269\u6563(\u98CE)0.75*\u53CD\u5E94\u5C42\u6570\uFF0C\u661F\u6269\u6563(\u51B0)2(\u53CD\u5E94\u5C42\u65701~2)\u62163(\u53CD\u5E94\u5C42\u65703~6)\n
        \u2022 \u7B49\u7EA7\u7CFB\u6570\uFF1A\u53EA\u4E0E\u89D2\u8272\u7B49\u7EA7\u6709\u5173\uFF0C90\u7EA7\u4E3A1446.853\uFF0C95\u7EA7\u4E3A1561.46\uFF0C100\u7EA7\u4E3A1674.81\uFF0C\u5176\u4E2D1~89\u7EA7\u9010\u7EA7\u589E\u52A0\uFF0C\u7531\u4E8E\u539F\u795E\u672A\u5F00\u653E90~100\u4E4B\u95F4\u7684\u7B49\u7EA7\uFF0C\u8BA1\u7B97\u65F691~94\u7EA7\u4E0E90\u7EA7\u76F8\u540C\uFF0C96~99\u7EA7\u4E0E95\u7EA7\u76F8\u540C\uFF0C\u8D85\u8FC7100\u8BA1\u4E3A100\u7EA7\n
        \u2022 \u989D\u5916\u4E58\u533A\uFF1A\u6FC0\u5316\u53CD\u5E94\u62E5\u6709\u4F24\u5BB3\u52A0\u6210\u3001\u66B4\u51FB\u671F\u671B\u3001\u9632\u5FA1\u4E58\u533A\uFF0C\u666E\u901A\u5267\u53D8\u62E5\u6709\u589E\u5E45\u53CD\u5E94\u4E58\u533A\uFF0C\u6708\u5267\u53D8(\u542B\u661F\u5267\u53D8)\u62E5\u6709\u66B4\u51FB\u671F\u671B\u3001\u6743\u91CD(\u56FA\u5B9A\u4E3A0.6\uFF0C\u591A\u4E2A\u89D2\u8272\u53C2\u4E0E\u6708\u5267\u53D8\u53CD\u5E94\u65F6\u7CFB\u6570\u4F9D\u6B21\u4E3A0.6\u30010.3\u30010.05\u30010.05\uFF0C\u672C\u8BA1\u7B97\u5668\u53EA\u8BA1\u7B97\u5355\u4E2A\u89D2\u8272\u6240\u4EE5\u56FA\u5B9A\u4E3A0.6)(\u5B9E\u9645\u6E38\u620F\u4E2D\u8FD8\u6709\u64E2\u5347\u4E58\u533A=(1+\u64E2\u5347)\uFF0C\u53EF\u4EE5\u4F7F\u7528\u6CBB\u7597\u6216\u62A4\u76FE\u4E58\u533A\u4EE3\u66FF)\n
